root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
tab_width = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.gradle]
indent_style = tab

[*.java]
# palantir-java-format (Spotless), same as MeowerClient
indent_style = space
indent_size = 4
max_line_length = 120

[*.json]
indent_style = space
indent_size = 2

[*.toml]
indent_style = tab
tab_width = 2

[*.properties]
indent_style = space
indent_size = 2
